# Copy to .env and replace every value. .env is git-ignored.
POSTGRES_PASSWORD=change-me
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-at-least-32-random-bytes-please
# Emails that become admins when they register (comma separated).
ADMIN_EMAILS=admin@example.com
